{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "bundler",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@lukebrannagan/design-system": ["libs/design-system/src/index.ts"],
			"@lukebrannagan/design-system/*": ["libs/design-system/src/*"],
			"@lukebrannagan/content": ["libs/content/src/index.ts"],
			"@lukebrannagan/content/*": ["libs/content/src/*"]
		},
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"exclude": ["node_modules", "tmp", "dist"]
}
