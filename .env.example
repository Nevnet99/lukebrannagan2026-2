# Optional override — defaults to site.amazon.associateTag (lukeb0f-21).
PUBLIC_AMAZON_ASSOCIATE_TAG=

# PostHog — leave empty to disable analytics (noop facade).
# Get the project API key from PostHog → Project settings.
PUBLIC_POSTHOG_KEY=
# EU cloud default; use https://us.i.posthog.com for US cloud.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
