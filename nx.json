{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "master",
	"analytics": false,
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.spec.ts"],
		"sharedGlobals": []
	},
	"targetDefaults": {
		"test": {
			"cache": true,
			"inputs": ["default", "^production"]
		},
		"lint": {
			"cache": true
		}
	},
	"plugins": [
		{
			"plugin": "@geekvetica/nx-astro",
			"options": {
				"devTargetName": "dev",
				"buildTargetName": "build",
				"previewTargetName": "preview",
				"checkTargetName": "check",
				"testTargetName": "test",
				"syncTargetName": "sync"
			}
		}
	]
}
