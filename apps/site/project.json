{
	"name": "site",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/site/src",
	"projectType": "application",
	"tags": ["type:app", "scope:site"],
	"targets": {
		"dev": {
			"executor": "@geekvetica/nx-astro:dev",
			"options": {},
			"cache": false
		},
		"fetch-book-covers": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun run apps/site/scripts/fetch-book-covers.mjs"
			},
			"inputs": [
				"{projectRoot}/scripts/fetch-book-covers.mjs",
				"{projectRoot}/src/content/writing/**/*",
				"{projectRoot}/public/covers/books/**/*"
			],
			"outputs": ["{projectRoot}/public/covers/books"],
			"cache": true
		},
		"build": {
			"executor": "@geekvetica/nx-astro:build",
			"options": {},
			"inputs": [
				"production",
				"^production",
				"{projectRoot}/package.json",
				{
					"externalDependencies": ["astro"]
				}
			],
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"cache": true,
			"dependsOn": ["fetch-book-covers", "^build"]
		},
		"preview": {
			"executor": "@geekvetica/nx-astro:preview",
			"options": {},
			"cache": false,
			"dependsOn": ["build"]
		},
		"check": {
			"executor": "@geekvetica/nx-astro:check",
			"options": {},
			"inputs": [
				"default",
				"^production",
				{
					"externalDependencies": ["astro", "typescript"]
				}
			],
			"cache": true,
			"dependsOn": ["sync"]
		},
		"sync": {
			"executor": "@geekvetica/nx-astro:sync",
			"options": {},
			"inputs": [
				"{projectRoot}/src/content/**/*",
				"{projectRoot}/src/content.config.ts",
				{
					"externalDependencies": ["astro"]
				}
			],
			"outputs": [],
			"cache": true
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check apps/site libs"
			}
		},
		"storybook": {
			"executor": "nx:run-commands",
			"options": {
				"command": "storybook dev --port 6007 --config-dir .storybook",
				"cwd": "apps/site"
			}
		},
		"build-storybook": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/storybook/site"],
			"options": {
				"command": "storybook build --config-dir .storybook --output-dir ../../dist/storybook/site",
				"cwd": "apps/site"
			}
		}
	}
}
