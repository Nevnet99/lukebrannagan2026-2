---
import { site } from "@lukebrannagan/content";
import CookieBanner from "../components/CookieBanner/CookieBanner.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: "website" | "article";
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	article?: {
		publishedTime: Date;
		modifiedTime?: Date;
		tags?: string[];
	};
}

const { title, description, image, ogType, noindex, jsonLd, article } = Astro.props;
const pathname = Astro.url.pathname;
const copyrightYear = new Date().getFullYear();
---

<BaseLayout
	title={title}
	description={description}
	image={image}
	ogType={ogType}
	noindex={noindex}
	jsonLd={jsonLd}
	article={article}
>
	<div class="shell">
		<header class="shell__header">
			<ds-container>
				<div class="shell__bar">
					<ds-link
						class="shell__brand"
						href="/"
						current={pathname === "/" ? "page" : undefined}
					>
						{site.name}
					</ds-link>
					<nav id="nav" class="shell__nav" aria-label="Primary" tabindex="-1">
						{
							site.nav.map((item) => (
								<ds-link
									href={item.href}
									current={
										pathname === item.href || pathname.startsWith(`${item.href}/`)
											? "page"
											: undefined
									}
								>
									{item.label}
								</ds-link>
							))
						}
						<ds-theme-toggle></ds-theme-toggle>
					</nav>
				</div>
			</ds-container>
		</header>

		<main id="main" class="shell__main" tabindex="-1">
			<slot />
		</main>

		<footer class="shell__footer">
			<ds-container>
				<ul class="shell__social">
					{
						site.social.map((item) => (
							<li>
								<ds-link href={item.href} external={item.href.startsWith("http")}>
									{item.label}
								</ds-link>
							</li>
						))
					}
					{
						site.footerLegal.map((item) => (
							<li>
								<ds-link
									href={item.href}
									current={pathname === item.href ? "page" : undefined}
								>
									{item.label}
								</ds-link>
							</li>
						))
					}
				</ul>
				<p class="shell__copyright">
					© {copyrightYear} {site.name}
				</p>
			</ds-container>
		</footer>
	</div>
	<CookieBanner />
</BaseLayout>

<style>
	.shell {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.shell__header {
		padding-block: var(--space-lg) var(--space-md);
		/* Hairline only — don’t compete with page surfaces */
		box-shadow: var(--shadow-border);
		background: color-mix(in oklch, var(--color-bg) 94%, transparent);
	}

	.shell__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		/* Match hit targets so Lit upgrade does not grow the header. */
		min-height: var(--hit-min);
	}

	.shell__brand::part(anchor) {
		font-weight: var(--font-weight-semibold);
		color: var(--color-fg);
		text-decoration: none;
	}

	.shell__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
		scroll-margin-block-start: var(--space-xl);
	}

	.shell__nav:focus {
		outline: none;
	}

	.shell__nav:focus-visible {
		outline: var(--focus-ring) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}

	.shell__nav ds-link::part(anchor) {
		text-decoration: none;
		color: var(--color-fg-muted);
		/* Keep weight stable — active state must not widen labels. */
		font-weight: var(--font-weight-medium);
	}

	@media (prefers-reduced-motion: no-preference) {
		.shell__nav ds-link::part(anchor) {
			transition-property: color;
			transition-duration: var(--duration-fast);
			transition-timing-function: var(--ease-out);
		}

		.shell__social ds-link::part(anchor) {
			transition-property: color;
			transition-duration: var(--duration-fast);
			transition-timing-function: var(--ease-out);
		}
	}

	@media (hover: hover) {
		.shell__nav ds-link:hover::part(anchor) {
			color: var(--color-accent-text);
		}

		.shell__brand:hover::part(anchor) {
			text-decoration: underline;
			text-decoration-thickness: from-font;
			text-underline-position: from-font;
			text-underline-offset: 0.12em;
			text-decoration-skip-ink: auto;
		}

		.shell__social ds-link:hover::part(anchor) {
			color: var(--color-fg);
			text-decoration: underline;
			text-decoration-thickness: from-font;
			text-underline-position: from-font;
			text-underline-offset: 0.12em;
			text-decoration-skip-ink: auto;
		}
	}

	.shell__nav ds-link[current="page"]::part(anchor) {
		color: var(--color-fg);
		font-weight: var(--font-weight-medium);
	}

	.shell__nav ds-theme-toggle {
		margin-inline-start: var(--space-xs);
	}

	.shell__main {
		flex: 1;
		padding-block-start: var(--space-2xl);
		padding-block-end: var(--space-4xl);
		scroll-margin-block-start: var(--space-xl);
	}

	.shell__main:focus {
		outline: none;
	}

	.shell__main:focus-visible {
		outline: var(--focus-ring) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}

	.shell__footer {
		padding-block: var(--space-2xl);
	}

	.shell__social {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
	}

	.shell__social ds-link::part(anchor) {
		font-size: var(--font-size-sm);
		color: var(--color-fg-muted);
		text-decoration: none;
	}

	.shell__copyright {
		margin: var(--space-md) 0 0;
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		letter-spacing: var(--letter-spacing-meta);
		line-height: var(--line-height-snug);
		color: var(--color-fg-subtle);
	}
</style>
