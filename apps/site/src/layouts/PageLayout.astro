---
import { site } from "@lukebrannagan/content";
import Container from "@lukebrannagan/design-system/components/Container.astro";
import Link from "@lukebrannagan/design-system/components/Link.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
	<div class="shell">
		<header class="shell__header">
			<Container>
				<div class="shell__bar">
					<Link href="/" class="shell__brand" aria-current={pathname === "/" ? "page" : undefined}>
						{site.name}
					</Link>
					<nav id="nav" class="shell__nav" aria-label="Primary">
						{
							site.nav.map((item) => (
								<Link
									href={item.href}
									aria-current={
										pathname === item.href || pathname.startsWith(`${item.href}/`)
											? "page"
											: undefined
									}
								>
									{item.label}
								</Link>
							))
						}
					</nav>
				</div>
			</Container>
		</header>

		<main id="main" class="shell__main">
			<slot />
		</main>

		<footer class="shell__footer">
			<Container>
				<ul class="shell__social">
					{
						site.social.map((item) => (
							<li>
								<Link href={item.href} external={item.href.startsWith("http")}>
									{item.label}
								</Link>
							</li>
						))
					}
				</ul>
			</Container>
		</footer>
	</div>
</BaseLayout>

<style>
	.shell {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.shell__header {
		padding-block: var(--space-xl) var(--space-2xl);
	}

	.shell__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.shell__brand {
		font-weight: var(--font-weight-medium);
		text-decoration: none;
	}

	.shell__brand:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.shell__nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.shell__nav :global(.link) {
		text-decoration: none;
		color: var(--color-fg-muted);
	}

	.shell__nav :global(.link:hover),
	.shell__nav :global(.link[aria-current="page"]) {
		color: var(--color-fg);
	}

	.shell__main {
		flex: 1;
		padding-bottom: var(--space-4xl);
	}

	.shell__footer {
		padding-block: var(--space-2xl);
		border-top: var(--rule) solid var(--color-border);
	}

	.shell__social {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.shell__social :global(.link) {
		font-size: var(--font-size-sm);
		color: var(--color-fg-muted);
		text-decoration: none;
	}

	.shell__social :global(.link:hover) {
		color: var(--color-fg);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
