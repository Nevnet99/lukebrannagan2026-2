---
import { projects } from "@lukebrannagan/content";
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout title="Work" description="Selected projects and case studies.">
	<ds-container>
		<ds-stack gap="2xl">
			<header>
				<ds-stack gap="sm">
					<ds-text as="h1" variant="display">Work</ds-text>
					<ds-text variant="muted">Selected projects and case studies.</ds-text>
				</ds-stack>
			</header>

			<ul class="list">
				{
					projects.map((project) => (
						<li class="list__item">
							<div class="list__row">
								<ds-link href={`/work/${project.slug}`}>{project.title}</ds-link>
								<span class="list__meta">
									{project.status === "in-progress" ? "In progress" : "Shipped"}
								</span>
							</div>
							<ds-text variant="muted">{project.summary}</ds-text>
						</li>
					))
				}
			</ul>
		</ds-stack>
	</ds-container>
</PageLayout>

<style>
	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.list__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.list__row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm) var(--space-lg);
	}

	.list__meta {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		color: var(--color-fg-subtle);
		letter-spacing: var(--letter-spacing-meta);
		text-transform: uppercase;
	}
</style>
