---
import {
	featuredExperience,
	formatTenure,
	getFeaturedProjects,
	site,
} from "@lukebrannagan/content";
import PageLayout from "../layouts/PageLayout.astro";

const featured = getFeaturedProjects();
---

<PageLayout>
	<ds-container>
		<ds-stack gap="3xl">
			<header class="intro">
				<ds-stack gap="md">
					<ds-text as="h1" variant="display">{site.name}</ds-text>
					<ds-text variant="muted">{site.role} · {site.location}</ds-text>
					<ds-text variant="body">{site.tagline}</ds-text>
				</ds-stack>
			</header>

			<section aria-labelledby="work-heading">
				<ds-stack gap="lg">
					<ds-text as="h2" id="work-heading" variant="meta">Selected work</ds-text>
					<ul class="list">
						{
							featured.map((project) => (
								<li class="list__item">
									<div class="list__row">
										<ds-link href={`/work/${project.slug}`}>{project.title}</ds-link>
										<span class="list__meta">{project.stack.join(" · ")}</span>
									</div>
									<ds-text variant="muted">{project.summary}</ds-text>
								</li>
							))
						}
					</ul>
					<p>
						<ds-link href="/work">All work</ds-link>
					</p>
				</ds-stack>
			</section>

			<section aria-labelledby="career-heading">
				<ds-stack gap="lg">
					<ds-text as="h2" id="career-heading" variant="meta">Career</ds-text>
					<ul class="list">
						{
							featuredExperience.map((role) => (
								<li class="list__item">
									<div class="list__row">
										<span>
											{role.role} · {role.company}
										</span>
										<span class="list__meta">
											{role.period} · {formatTenure(role)}
										</span>
									</div>
								</li>
							))
						}
					</ul>
					<p>
						<ds-link href="/cv">Full CV</ds-link>
					</p>
				</ds-stack>
			</section>

			<section aria-labelledby="writing-heading">
				<ds-stack gap="lg">
					<ds-text as="h2" id="writing-heading" variant="meta">Writing</ds-text>
					<ds-text variant="muted">Notes and essays will live here.</ds-text>
					<p>
						<ds-link href="/writing">All writing</ds-link>
					</p>
				</ds-stack>
			</section>

			<section aria-labelledby="contact-heading">
				<ds-stack gap="md">
					<ds-rule></ds-rule>
					<ds-text as="h2" id="contact-heading" variant="meta">Contact</ds-text>
					<ds-text variant="body">{site.cta.body}</ds-text>
					<p>
						<ds-link href={`mailto:${site.email}`}>{site.email}</ds-link>
					</p>
				</ds-stack>
			</section>
		</ds-stack>
	</ds-container>
</PageLayout>

<style>
	.intro {
		padding-top: var(--space-md);
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.list__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.list__row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm) var(--space-lg);
	}

	.list__meta {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		color: var(--color-fg-subtle);
		letter-spacing: var(--letter-spacing-meta);
	}
</style>
