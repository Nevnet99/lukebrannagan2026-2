---
import { getCollection } from "astro:content";
import {
	getWorkSeriesMembers,
	isWritingPubliclyLinked,
	listFeaturedWorkEntries,
	readingTimeLabel,
	site,
} from "@lukebrannagan/content";
import SeriesStack from "../components/SeriesStack.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { formatPostDate } from "../lib/dates";

const featuredWork = listFeaturedWorkEntries();
const recentWriting = (await getCollection("writing"))
	.filter((post) => !post.data.archived && isWritingPubliclyLinked(post.data))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<PageLayout>
	<ds-container>
		<ds-stack gap="3xl">
			<header class="intro">
				<ds-stack gap="md">
					<ds-text as="h1" variant="display">{site.name}</ds-text>
					<ds-text variant="muted">{site.role} · {site.location}</ds-text>
					<ds-text variant="body">{site.tagline}</ds-text>
				</ds-stack>
			</header>

			<section aria-labelledby="work-heading">
				<ds-stack gap="md">
					<div class="section-head">
						<ds-text as="h2" id="work-heading" variant="meta">Selected work</ds-text>
						<ds-link class="section-head__link" href="/work">View all</ds-link>
					</div>
					<ul class="surface-list">
						{
							featuredWork.map((entry) =>
								entry.type === "series" ? (
									<SeriesStack
										series={entry.series}
										members={getWorkSeriesMembers(entry.series)}
									/>
								) : (
									<li>
										<article class="surface surface--interactive">
											<div class="surface__row">
												<ds-link stretch href={`/work/${entry.project.slug}`}>
													<span class="surface__icon">
														<ds-icon name="web"></ds-icon>
													</span>
													{entry.project.title}
												</ds-link>
												<span class="surface__meta">
													{entry.project.stack.join(" · ")}
												</span>
											</div>
											<ds-text variant="muted">{entry.project.summary}</ds-text>
										</article>
									</li>
								),
							)
						}
					</ul>
				</ds-stack>
			</section>

			<section aria-labelledby="writing-heading">
				<ds-stack gap="md">
					<div class="section-head">
						<ds-text as="h2" id="writing-heading" variant="meta">Writing</ds-text>
						{
							recentWriting.length > 0 && (
								<ds-link class="section-head__link" href="/writing">
									All writing
								</ds-link>
							)
						}
					</div>
					{
						recentWriting.length === 0 ? (
							<ds-stack gap="md">
								<ds-text variant="muted">{site.writing.empty}</ds-text>
								<p>
									<ds-link href={site.writing.emptyAction.href}>
										{site.writing.emptyAction.label}
									</ds-link>
								</p>
							</ds-stack>
						) : (
							<ul class="surface-list">
								{recentWriting.map((post) => (
									<li>
										<article class="surface surface--interactive">
											<div class="surface__row">
												<ds-link stretch href={`/writing/${post.id}`}>
													<span class="surface__icon">
														<ds-icon name="article"></ds-icon>
													</span>
													{post.data.title}
												</ds-link>
												<span class="surface__meta">
													{formatPostDate(post.data.pubDate)} ·{" "}
													{readingTimeLabel(post.body ?? "")}
												</span>
											</div>
											<ds-text variant="muted">{post.data.description}</ds-text>
										</article>
									</li>
								))}
							</ul>
						)
					}
				</ds-stack>
			</section>

			<section aria-labelledby="contact-heading">
				<ds-stack gap="md">
					<ds-text as="h2" id="contact-heading" variant="meta">Contact</ds-text>
					<ds-text variant="body">{site.cta.body}</ds-text>
					<p>
						<ds-link href={`mailto:${site.email}`}>{site.email}</ds-link>
					</p>
				</ds-stack>
			</section>
		</ds-stack>
	</ds-container>
</PageLayout>

<style>
	.intro {
		padding-top: 0;
	}

	.section-head {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.section-head ds-text {
		flex: 1 1 auto;
		min-width: 0;
		max-width: none;
	}

	/* Inline with the heading — don't let ds-link's hit-min inflate heading→content gap */
	.section-head__link {
		flex: 0 0 auto;
		min-height: 0;
		align-self: baseline;
	}

	.section-head__link::part(anchor) {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		letter-spacing: var(--letter-spacing-meta);
		text-decoration: none;
		color: var(--color-fg-subtle);
		min-height: 0;
	}

	@media (hover: hover) {
		.section-head__link:hover::part(anchor) {
			color: var(--color-accent-text);
			text-decoration: underline;
			text-decoration-thickness: from-font;
			text-underline-position: from-font;
			text-underline-offset: 0.12em;
		}
	}
</style>
