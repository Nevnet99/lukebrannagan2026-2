---
import { experience, formatTenure, site, skills } from "@lukebrannagan/content";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="CV" description={site.summary}>
	<ds-container>
		<ds-stack gap="3xl">
			<header>
				<ds-stack gap="sm">
					<ds-text as="h1" variant="display">CV</ds-text>
					<ds-text variant="muted">{site.role} · {site.location}</ds-text>
					<ds-text variant="body">{site.summary}</ds-text>
				</ds-stack>
			</header>

			<section aria-labelledby="experience-heading">
				<ds-stack gap="lg">
					<ds-text as="h2" id="experience-heading" variant="meta">Experience</ds-text>
					<ul class="list">
						{
							experience.map((role) => (
								<li class="list__item">
									<div class="list__row">
										<span>
											{role.role} · {role.company}
										</span>
										<span class="list__meta">
											{role.period} · {formatTenure(role)}
										</span>
									</div>
									<ul class="highlights">
										{role.highlights.map((item) => (
											<li>
												<ds-text variant="muted">{item}</ds-text>
											</li>
										))}
									</ul>
								</li>
							))
						}
					</ul>
				</ds-stack>
			</section>

			<section aria-labelledby="skills-heading">
				<ds-stack gap="lg">
					<ds-text as="h2" id="skills-heading" variant="meta">Skills</ds-text>
					<ul class="skills">
						{
							skills.map((group) => (
								<li class="skills__group">
									<ds-text variant="title">{group.title}</ds-text>
									<ds-text variant="muted">{group.items.join(", ")}</ds-text>
								</li>
							))
						}
					</ul>
				</ds-stack>
			</section>
		</ds-stack>
	</ds-container>
</PageLayout>

<style>
	.list,
	.skills,
	.highlights {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.list,
	.skills {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.list__item,
	.skills__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.list__row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm) var(--space-lg);
	}

	.list__meta {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		color: var(--color-fg-subtle);
		letter-spacing: var(--letter-spacing-meta);
	}

	.highlights {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		padding-inline-start: 0;
	}
</style>
