---
import { type CollectionEntry, getCollection, render } from "astro:content";
import {
	amazonProductUrl,
	bookCoverSrc,
	getSeries,
	isWritingPubliclyLinked,
	readingTimeLabel,
	relatedWritingPosts,
	seriesHref,
	site,
	writingTopicLabel,
} from "@lukebrannagan/content";
import BookViewer from "../../components/BookViewer.astro";
import ScrollProgress from "../../components/ScrollProgress.astro";
import StarRating from "../../components/StarRating.astro";
import Toc from "../../components/Toc.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { formatPostDate, formatPostDateLong } from "../../lib/dates";

export async function getStaticPaths() {
	const posts = (await getCollection("writing")).filter((post) =>
		isWritingPubliclyLinked(post.data),
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, posts },
	}));
}

const {
	post,
	posts,
}: {
	post: CollectionEntry<"writing">;
	posts: CollectionEntry<"writing">[];
} = Astro.props;
const { Content, headings } = await render(post);
const readLabel = readingTimeLabel(post.body ?? "");
const topicLabels = post.data.tags.map((tag) => writingTopicLabel(tag));
const toc = headings
	.filter((heading) => heading.depth === 2 || heading.depth === 3)
	.map((heading) => ({
		id: heading.slug,
		label: heading.text,
		depth: heading.depth as 2 | 3,
	}));

const related = relatedWritingPosts(
	{
		id: post.id,
		tags: post.data.tags,
		series: post.data.series,
		pubDate: post.data.pubDate,
	},
	posts.map((entry) => ({
		id: entry.id,
		title: entry.data.title,
		description: entry.data.description,
		tags: entry.data.tags,
		series: entry.data.series,
		pubDate: entry.data.pubDate,
		archived: entry.data.archived,
		listed: entry.data.listed,
		body: entry.body ?? "",
	})),
	3,
);
const bookSeries = post.data.series != null ? getSeries(post.data.series, "writing") : null;
const isBookReview = bookSeries?.layout === "bookshelf";
const pending = post.data.reviewStatus === "to-be-reviewed";

const associateTag =
	(typeof import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG === "string"
		? import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG.trim()
		: "") || site.amazon.associateTag;

const coverSrc = isBookReview
	? bookCoverSrc({
			slug: post.id,
			cover: post.data.cover,
			isbn: post.data.isbn,
		})
	: null;

const amazonHref = isBookReview
	? amazonProductUrl({
			title: post.data.title,
			author: post.data.bookAuthor,
			asin: post.data.amazonAsin,
			isbn: post.data.isbn,
			marketplace: site.amazon.marketplace,
			tag: associateTag || undefined,
		})
	: null;

const breadcrumb = (() => {
	if (bookSeries) {
		return [
			{ label: "Writing", href: "/writing" },
			{ label: bookSeries.title, href: seriesHref(bookSeries) },
			{ label: post.data.title },
		];
	}
	if (post.data.archived) {
		return [
			{ label: "Writing", href: "/writing" },
			{ label: "Archived", href: "/writing/archived" },
			{ label: post.data.title },
		];
	}
	return [{ label: "Writing", href: "/writing" }, { label: post.data.title }];
})();
---

<PageLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	noindex={post.data.archived || post.data.listed === false}
	article={{
		publishedTime: post.data.pubDate,
		modifiedTime: post.data.updatedDate,
		tags: topicLabels,
	}}
>
	<ScrollProgress />
	<ds-container class="article-layout">
		<article class="post" data-scroll-progress-root>
			<div class="article-body">
				<header class="article-hero">
					<ds-stack gap="sm">
						<ds-breadcrumb items={JSON.stringify(breadcrumb)}></ds-breadcrumb>
						{
							post.data.archived && (
								<ds-text variant="meta">Archived</ds-text>
							)
						}
						{
							pending && (
								<ds-text variant="meta">To be reviewed</ds-text>
							)
						}
						{
							isBookReview && (
								<div class="book-hero">
									<BookViewer
										title={post.data.title}
										author={post.data.bookAuthor}
										cover={coverSrc}
										coverBack={post.data.coverBack}
										spine={post.data.spine}
										description={post.data.description}
									/>
									<div class="book-hero__copy">
										<ds-text as="h1" variant="display">{post.data.title}</ds-text>
										{post.data.bookAuthor && (
											<ds-text variant="muted">{post.data.bookAuthor}</ds-text>
										)}
										{post.data.rating != null && (
											<p class="book-rating">
												<StarRating rating={post.data.rating} />
											</p>
										)}
										{amazonHref && (
											<p class="book-buy">
												<ds-link href={amazonHref} external>
													Buy on Amazon
												</ds-link>
												<span class="book-buy__note">
													Affiliate link — I may earn a commission.
												</span>
											</p>
										)}
									</div>
								</div>
							)
						}
						{
							!isBookReview && (
								<>
									<ds-text as="h1" variant="display">{post.data.title}</ds-text>
									<ds-text variant="muted">
										<time datetime={post.data.pubDate.toISOString()}>
											{formatPostDateLong(post.data.pubDate)}
										</time>
										{" · "}
										{readLabel}
									</ds-text>
								</>
							)
						}
						{
							post.data.updatedDate && (
								<ds-text variant="meta">
									Updated{" "}
									<time datetime={post.data.updatedDate.toISOString()}>
										{formatPostDateLong(post.data.updatedDate)}
									</time>
								</ds-text>
							)
						}
						{
							post.data.tags.length > 0 && (
								<p class="tags">
									{post.data.tags.map((tag) => (
										<span class="tag">{writingTopicLabel(tag)}</span>
									))}
								</p>
							)
						}
					</ds-stack>
				</header>

				{
					toc.length > 0 && (
						<aside class="article-rail" aria-label="On this page">
							<Toc items={toc} />
						</aside>
					)
				}

				<div class="article-content">
					<div class="prose" data-heading-permalinks>
						<Content />
					</div>

					<footer>
						<ds-stack gap="sm">
							<ds-rule></ds-rule>
							<p>
								<ds-link href="/writing">All writing</ds-link>
								{
									post.data.source && (
										<>
											{" · "}
											<ds-link href={post.data.source} external>
												Originally on DEV
											</ds-link>
										</>
									)
								}
								{" · "}
								<ds-link href="/rss.xml">{site.writing.rssLabel}</ds-link>
								{" · "}
								<ds-link href={`mailto:${site.email}`}>Email</ds-link>
							</p>
						</ds-stack>
					</footer>

					{
						related.length > 0 && (
							<section class="related" aria-labelledby="related-heading">
								<ds-stack gap="md">
									<ds-text as="h2" id="related-heading" variant="meta">
										{site.writing.relatedHeading}
									</ds-text>
									<ul class="surface-list">
										{related.map((entry) => (
											<li>
												<article class="surface surface--interactive">
													<div class="surface__row">
														<ds-link stretch href={`/writing/${entry.id}`}>
															<span class="surface__icon">
																<ds-icon name="article"></ds-icon>
															</span>
															{entry.title}
														</ds-link>
														<span class="surface__meta">
															{formatPostDate(entry.pubDate)} ·{" "}
															{readingTimeLabel(entry.body)}
														</span>
													</div>
													<ds-text variant="muted">{entry.description}</ds-text>
												</article>
											</li>
										))}
									</ul>
								</ds-stack>
							</section>
						)
					}
				</div>
			</div>
		</article>
	</ds-container>
</PageLayout>

<script>
	import "../../scripts/heading-permalinks";
	import "../../scripts/scroll-progress";
</script>

<style>
	.article-body {
		--rail-width: 12rem;
		--rail-gap: var(--space-xl);
		display: grid;
		gap: var(--space-section);
		align-items: start;
		grid-template-areas:
			"hero"
			"toc"
			"content";
	}

	.article-hero {
		grid-area: hero;
		min-inline-size: 0;
	}

	.book-hero {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-lg);
	}

	.book-hero__copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		min-inline-size: min(100%, 16rem);
		flex: 1 1 16rem;
	}

	.book-buy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2xs);
		margin: 0;
	}

	.book-buy__note {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		letter-spacing: var(--letter-spacing-meta);
		color: var(--color-fg-subtle);
	}

	.article-rail {
		grid-area: toc;
		min-inline-size: 0;
	}

	.article-content {
		grid-area: content;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
		min-inline-size: 0;
	}

	.related {
		min-inline-size: 0;
	}

	/* Content stays at --page-max (nav width); TOC hangs in the left margin */
	@media (min-width: 70rem) {
		.article-body:has(> .article-rail) {
			grid-template-columns: var(--rail-width) minmax(0, 1fr);
			grid-template-areas:
				". hero"
				"toc content";
			column-gap: var(--rail-gap);
			row-gap: var(--space-section);
			width: calc(100% + var(--rail-width) + var(--rail-gap));
			margin-inline-start: calc(-1 * (var(--rail-width) + var(--rail-gap)));
		}

		.article-rail {
			position: sticky;
			top: var(--space-xl);
			align-self: start;
		}
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin: 0;
	}

	.book-rating {
		margin: 0;
	}

	.tag {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		letter-spacing: var(--letter-spacing-meta);
		color: var(--color-fg-subtle);
	}

	.prose {
		max-width: var(--measure);
		font-size: var(--font-size-md);
		line-height: var(--line-height-relaxed);
		color: var(--color-fg);
		overflow-x: auto;
	}

	.prose :global(> * + *) {
		margin-block-start: var(--space-md);
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-block-start: var(--space-xl);
		margin-block-end: var(--space-sm);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-tight);
		text-wrap: balance;
		scroll-margin-block-start: var(--space-xl);
	}

	.prose :global(h2) {
		font-size: var(--font-size-lg);
	}

	.prose :global(h3),
	.prose :global(h4) {
		font-size: var(--font-size-md);
	}

	.prose :global(p),
	.prose :global(li) {
		overflow-wrap: break-word;
	}

	.prose :global(a) {
		color: var(--color-accent-text);
		text-decoration: underline;
		text-decoration-thickness: from-font;
		text-underline-offset: 0.12em;
		text-decoration-color: color-mix(in oklch, var(--color-accent-text) 40%, transparent);
	}

	@media (hover: hover) {
		.prose :global(a:hover) {
			color: var(--color-accent-hover);
			text-decoration-color: var(--color-accent-hover);
		}
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.prose :global(hr) {
		border: 0;
		border-block-start: var(--rule) solid var(--color-border);
		margin-block: var(--space-xl);
	}

	.prose :global(blockquote) {
		margin: 0;
		padding-inline-start: var(--space-md);
		border-inline-start: 2px solid var(--color-border-strong);
		color: var(--color-fg-muted);
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	.prose :global(strong) {
		font-weight: var(--font-weight-semibold);
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--font-size-sm);
		line-height: var(--line-height-normal);
	}

	.prose :global(th),
	.prose :global(td) {
		padding: var(--space-xs) var(--space-sm);
		border: var(--rule) solid var(--color-border);
		text-align: start;
		vertical-align: top;
	}

	.prose :global(th) {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-meta);
		color: var(--color-fg-muted);
		background: var(--color-accent-subtle);
	}

	.prose :global(caption) {
		caption-side: bottom;
		padding-block-start: var(--space-xs);
		font-size: var(--font-size-xs);
		color: var(--color-fg-subtle);
		text-align: start;
	}
</style>
