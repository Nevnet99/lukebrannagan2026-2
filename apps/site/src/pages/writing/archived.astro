---
import { getCollection } from "astro:content";
import {
	isWritingPubliclyLinked,
	readingTimeLabel,
	site,
	writingTopicLabel,
} from "@lukebrannagan/content";
import PageLayout from "../../layouts/PageLayout.astro";
import { formatPostDate } from "../../lib/dates";

const posts = (await getCollection("writing"))
	.filter((post) => post.data.archived && isWritingPubliclyLinked(post.data))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title="Archived writing" description={site.writing.archivedLede}>
	<ds-container>
		<ds-stack gap="2xl">
			<header>
				<ds-stack gap="sm">
					<ds-breadcrumb
						items={JSON.stringify([
							{ label: "Writing", href: "/writing" },
							{ label: "Archived" },
						])}
					></ds-breadcrumb>
					<ds-text as="h1" variant="display">Archived</ds-text>
					<ds-text variant="muted">{site.writing.archivedLede}</ds-text>
				</ds-stack>
			</header>

			{
				posts.length === 0 ? (
					<ds-text variant="muted">No archived posts.</ds-text>
				) : (
					<ul class="surface-list">
						{posts.map((post) => (
							<li>
								<article class="surface surface--interactive">
									<div class="surface__row">
										<ds-link stretch href={`/writing/${post.id}`}>
											<span class="surface__icon">
												<ds-icon name="article"></ds-icon>
											</span>
											{post.data.title}
										</ds-link>
										<span class="surface__meta">
											{formatPostDate(post.data.pubDate)} ·{" "}
											{readingTimeLabel(post.body ?? "")}
										</span>
									</div>
									<ds-text variant="muted">{post.data.description}</ds-text>
									{
										post.data.tags.length > 0 && (
											<p class="surface__tags">
												{post.data.tags.map((tag) => (
													<span class="surface__tag">{writingTopicLabel(tag)}</span>
												))}
											</p>
										)
									}
								</article>
							</li>
						))}
					</ul>
				)
			}
		</ds-stack>
	</ds-container>
</PageLayout>

<style>
	.surface__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin: 0;
	}

	.surface__tag {
		font-family: var(--font-meta);
		font-size: var(--font-size-xs);
		letter-spacing: var(--letter-spacing-meta);
		color: var(--color-fg-subtle);
	}
</style>
