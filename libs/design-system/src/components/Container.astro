---
interface Props {
	as?: "div" | "main" | "article" | "section" | "header" | "footer" | "nav";
	class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", className]}>
	<slot />
</Tag>

<style>
	.container {
		width: min(100% - (var(--page-gutter) * 2), var(--page-max));
		margin-inline: auto;
	}
</style>
