---
interface Props {
	as?: "div" | "ul" | "ol" | "section" | "header" | "footer" | "nav";
	gap?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl";
	class?: string;
}

const { as: Tag = "div", gap = "md", class: className } = Astro.props;
---

<Tag class:list={["stack", className]} data-gap={gap}>
	<slot />
</Tag>

<style>
	.stack {
		display: flex;
		flex-direction: column;
	}

	.stack[data-gap="xs"] {
		gap: var(--space-xs);
	}
	.stack[data-gap="sm"] {
		gap: var(--space-sm);
	}
	.stack[data-gap="md"] {
		gap: var(--space-md);
	}
	.stack[data-gap="lg"] {
		gap: var(--space-lg);
	}
	.stack[data-gap="xl"] {
		gap: var(--space-xl);
	}
	.stack[data-gap="2xl"] {
		gap: var(--space-2xl);
	}
	.stack[data-gap="3xl"] {
		gap: var(--space-3xl);
	}
</style>
