---
interface Props {
	href: string;
	external?: boolean;
	class?: string;
	"aria-current"?: "page" | "true" | undefined;
}

const { href, external = false, class: className, "aria-current": ariaCurrent } = Astro.props;

const isExternal = external || /^https?:\/\//.test(href);
---

<a
	href={href}
	class:list={["link", className]}
	aria-current={ariaCurrent}
	target={isExternal ? "_blank" : undefined}
	rel={isExternal ? "noopener noreferrer" : undefined}
>
	<slot />
</a>

<style>
	.link {
		color: var(--color-fg);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		text-decoration-color: color-mix(in srgb, var(--color-fg) 35%, transparent);
		transition: text-decoration-color var(--duration-fast) var(--ease-out);
	}

	.link:hover {
		text-decoration-color: var(--color-fg);
	}

	.link[aria-current="page"] {
		text-decoration: none;
		font-weight: var(--font-weight-medium);
	}
</style>
