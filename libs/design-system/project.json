{
	"name": "design-system",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/design-system/src",
	"projectType": "library",
	"tags": ["type:design-system", "scope:shared"],
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run",
				"cwd": "libs/design-system"
			}
		},
		"storybook": {
			"executor": "nx:run-commands",
			"options": {
				"command": "storybook dev --port 6006 --config-dir .storybook",
				"cwd": "libs/design-system"
			}
		},
		"build-storybook": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/storybook/design-system"],
			"options": {
				"command": "storybook build --config-dir .storybook --output-dir ../../dist/storybook/design-system",
				"cwd": "libs/design-system"
			}
		}
	}
}
